# ==============================================================================
# PageVault Bookshop - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and update values for your local environment:
#   cp .env.example .env
# Note: PageVault requires ZERO external dependencies and runs automatically
# with its embedded database out of the box if MySQL is not configured.
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=127.0.0.1

# MySQL Database Settings (Optional - fallback to embedded SQLite if unreachable)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=pagevault_db

# Security & Session Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
